<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vehicle Identity Configuration"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select vehicle type and manage unique V2V transmission ID."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Vehicle Types Radio/Grid -->
    <RadioGroup
        android:id="@+id/rgVehicleTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Car (Standard Passenger Vehicle)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbBike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Bike / Motorcycle (High Maneuverability)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbTruck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Truck / Heavy Freight (High Stopping Distance)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbBus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Bus / Public Transport"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/surface_card_stroke" />

    <Button
        android:id="@+id/btnRegenerateVehicleId"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Regenerate Unique Vehicle ID"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSaveVehicleConfig"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:text="Save &amp; Apply" />

</LinearLayout>
